{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonForge Bestiary Entity Schema (OKF v0.3)",
  "type": "object",
  "required": ["okf_version", "title", "type", "id", "classification", "origin", "rarity", "element"],
  "properties": {
    "okf_version": {
      "type": "string",
      "enum": ["0.3"]
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["Bestiary Entity"]
    },
    "id": {
      "type": "string",
      "pattern": "^mon_[a-z0-9_]+$"
    },
    "classification": {
      "type": "string",
      "enum": ["mob", "elite", "miniboss", "named_boss", "world_boss"]
    },
    "origin": {
      "type": "string",
      "enum": ["hearthspawn", "beast", "construct", "flora", "aberration"]
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    },
    "element": {
      "type": "string",
      "enum": ["Fire", "Wind", "Water", "Earth", "Light", "Dark", "Physical", "None"]
    },
    "aspect": {
      "type": "string",
      "enum": ["Attack", "Tank", "Stun", "Support", "Speed"]
    },
    "base_hp": {
      "type": "integer",
      "minimum": 1
    },
    "base_atk": {
      "type": "integer",
      "minimum": 1
    },
    "primary_habitat": {
      "type": "string"
    },
    "danger_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "weaknesses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "immunities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signature_drops": {
      "type": "array",
      "items": { "type": "string" }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
