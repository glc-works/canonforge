{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonForge Character Entity Schema (OKF v0.3)",
  "type": "object",
  "required": ["okf_version", "title", "type", "id", "birth_date"],
  "properties": {
    "okf_version": {
      "type": "string",
      "enum": ["0.3"]
    },
    "title": {
      "type": "string",
      "description": "Canonical full name or title of the character"
    },
    "type": {
      "type": "string",
      "enum": ["Character Entity"]
    },
    "mode": {
      "type": "string",
      "enum": ["reference", "explanation", "tutorial", "how-to"],
      "default": "reference"
    },
    "status": {
      "type": "string",
      "enum": ["canonical", "draft", "proposed"],
      "default": "canonical"
    },
    "authority": {
      "type": "string",
      "enum": ["canon-lead", "community", "draft"],
      "default": "canon-lead"
    },
    "id": {
      "type": "string",
      "pattern": "^char_[a-z0-9_]+$",
      "description": "Unique namespaced snake_case identifier starting with char_"
    },
    "faction": {
      "type": "string",
      "enum": [
        "Human",
        "Cyborg",
        "Valen",
        "The Syndicate",
        "Animus",
        "Neutral",
        "Lawless",
        "Unassigned",
        "Wild / Hybrid"
      ]
    },
    "house": {
      "type": "string",
      "description": "Lineage house or clan name"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "role": {
      "type": "string"
    },
    "entity_status": {
      "type": "string",
      "enum": ["Active", "Alive", "Deceased", "Missing", "Excised"],
      "default": "Alive"
    },
    "birth_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Standard in-world calendar date in YYYY-MM-DD format"
    },
    "birthplace": {
      "type": "string"
    },
    "forged": {
      "type": "boolean",
      "description": "Indicates whether the character has undergone cybernetic alteration"
    },
    "strength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "dexterity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "vitality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "willpower": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "force": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "description": "Spiritual or magic energy affinity"
    },
    "system_affinity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "description": "Mechanical/cybernetic chassis tolerance"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "object",
      "description": "Continuity guard invariants (eyes, scars, weapons, forbidden traits)"
    },
    "visual_identity": {
      "type": "object",
      "description": "Color swatches, HEX palettes, and asset links"
    },
    "quotes": {
      "type": "object",
      "description": "Iconic quotes and in-character perspectives on other figures"
    },
    "production_meta": {
      "type": "object",
      "description": "Behind-the-scenes literary mirrors and concept origins"
    }
  }
}
